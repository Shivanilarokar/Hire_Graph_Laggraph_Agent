# ==== HireGraph environment (copy to .env; .env is gitignored) ====

# === Required ===
OPENAI_API_KEY=
HIRE_MODEL=gpt-4o-mini

# === Recommended free services (all optional; mocks work if unset) ===
TAVILY_API_KEY=
GITHUB_API_BASE=https://api.github.com
GITHUB_TOKEN=

# Mailtrap sandbox (sign up at https://mailtrap.io); auto-mocked if blank
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
EMAIL_FROM=recruiting@hiregraph.example

# === Checkpointer ===
# memory | redis
CHECKPOINTER=memory
# redis://default:PASSWORD@HOST:PORT  (Redis Cloud DB needs RedisJSON + RediSearch)
REDIS_URL=

# === Evaluator-optimizer loop ===
EMAIL_MAX_REVISIONS=3

# === Observability (recommended) ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hiregraph

# === Toggles ===
# Force every external service to use its deterministic mock implementation.
HIREGRAPH_USE_MOCKS=false
